    <string name="commitment_release_cancel_text">The 7-day timer will be reset and the commitment continues as it was.</string>
    <string name="commitment_release_finish_title">End the commitment now?</string>
    <string name="commitment_release_finish_text">The 7-day waiting period is over. Enter the recovery code to stop the commitment. Protection stays on; only the settings freeze is lifted.</string>
