    <string name="got_it">Got it</string>
    <string name="onboarding_slide_0_title">What Sarim is</string>
    <string name="onboarding_slide_0_body">A blocker built for one job: keeping pornography and adult content off this phone, and keeping the way in closed.</string>
    <string name="onboarding_slide_1_title">Your session</string>
    <string name="onboarding_slide_1_body">The recovery code opens a 10-minute session for changing settings. Ending the commitment early takes an order confirmed with the code and a 7-day wait.</string>
    <string name="onboarding_slide_2_title">Blocking, not managing</string>
    <string name="onboarding_slide_2_body">Adult images and video, forbidden words, adult sites in every browser, forced SafeSearch, filtering DNS, Tor and torrents — all on from the first launch.</string>
    <string name="onboarding_slide_3_title">Your commitment</string>
    <string name="onboarding_slide_3_body">You choose at least 90 days, permanent, or Regular. Protection always stays on; a commitment only locks the settings until it ends.</string>
    <string name="onboarding_slide_4_title">Device owner setup</string>
    <string name="onboarding_slide_4_body">Owner privileges, granted through Shizuku, are what lock the system doors: VPN, private DNS, sideloading and uninstalling.</string>
    <string name="onboarding_slide_4_cta">Set up now</string>
    <string name="onboarding_slide_4_note">Required for the system restrictions to apply.</string>

    <!-- Commitment -->
    <string name="commitment_setup_title">Set your commitment</string>
    <string name="commitment_setup_intro">Protection is set up. Choose how long it stays locked on, or pick Regular to keep settings changeable with the recovery code.</string>
    <plurals name="commitment_duration_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <string name="commitment_duration_regular">Regular</string>
    <string name="commitment_regular_note">No commitment — settings can be changed with the recovery code whenever you want</string>
    <string name="commitment_duration_permanent">Permanent</string>
    <string name="commitment_permanent_note">Never ends — the 48-hour forced removal is disabled</string>
    <string name="commitment_pins_title">What stays on</string>
    <string name="commitment_pins_body">Visual blocking of adult images and video in every monitored app, the built-in forbidden words, adult-site blocking in every browser, forced SafeSearch, a family DNS resolver, Tor/Orbot and torrent blocking, and the device restrictions that stop a VPN, a sideloaded app, an uninstall or a clock change from getting around them.</string>
    <string name="commitment_acknowledge">I understand settings stay locked for this period — not with the recovery code, not from Android settings. The only early exit is the 7-day release order confirmed with the code.</string>
    <string name="commitment_acknowledge_regular">I understand protection stays on, but I can change settings with the recovery code whenever I want.</string>
    <string name="commitment_start_button">Start the commitment</string>
    <string name="commitment_start_regular">Continue without a commitment</string>
