    <string name="commitment_stopped_status">Ended early</string>
    <string name="commitment_release_title">End commitment early</string>
    <string name="commitment_release_desc">Place an order to end it: confirm with the recovery code, wait 7 days, then confirm again.</string>
    <string name="commitment_release_request_title">Order the end of the commitment?</string>
    <string name="commitment_release_request_text">Confirm with the recovery code, then a 7-day waiting period starts. After it ends, enter the code again to stop the commitment. You can cancel the order at any time during the wait; that resets the timer and keeps the commitment running as it was.</string>
