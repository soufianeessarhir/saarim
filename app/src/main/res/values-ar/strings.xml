    <string name="recovery_wizard_intro_step_store">ضع الورقة في مكان آمن</string>
    <string name="recovery_wizard_intro_hint">احضر قلمًا وورقة قبل المتابعة.</string>
    <string name="recovery_wizard_write_title">اكتبه على الورق</string>
    <string name="recovery_wizard_write_text">انسخ الـ 16 حرفًا تمامًا كما هو موضح. لا تأخذ لقطة شاشة ولا تحفظه على هاتفك — النسخة القريبة منك سهلة الاستخدام في لحظة الاندفاع.</string>
    <string name="recovery_wizard_reveal">إظهار الرمز</string>
    <string name="recovery_wizard_written">كتبت الرمز على الورق</string>
    <string name="recovery_wizard_confirm_title">تحقّق مما كتبته</string>
    <string name="recovery_wizard_confirm_text">الرمز مختفي الآن. اكتبه من ورقك للتأكد من صحة كل حرف.</string>
    <string name="recovery_wizard_confirm_match">الرمز صحيح</string>
    <string name="recovery_wizard_confirm_mismatch">لا يطابق. ارجع وقارنه مع ورقك.</string>
    <string name="recovery_wizard_store_title">خزّنه في مكان آمن</string>
    <string name="recovery_wizard_store_text">الورقة هي الآن النسخة الوحيدة من رمزك. اختر بعناية أين تحفظها.</string>
    <string name="recovery_wizard_store_tip_away">بعيدًا عن هاتفك، في مكان لن تصل إليه في لحظة الاندفاع</string>
    <string name="recovery_wizard_store_tip_findable">سهل العثور عليه عندما تحتاجه حقًا — درج، ملف، أو مع شخص تثق به</string>
    <string name="recovery_wizard_store_tip_digital">لا صور أو نسخ رقمية</string>
    <string name="recovery_wizard_store_tip_partner">والأفضل من ذلك: سلّمه لشريك محاسبة يحتفظ به نيابة عنك</string>
    <string name="partner_share_button">إرسال إلى شريك المحاسبة</string>
    <string name="partner_share_chooser">مشاركة رمز الاستعادة</string>
    <string name="partner_share_message">رمز الاستعادة في Sarim هو %1$s. احتفظ به في مكان لا أستطيع الوصول إليه — أحتاجه لتغيير قيودي، ولا أريد أن أتمكن من الوصول إليه في لحظة الاندفاع.</string>
